---
import 'leaflet/dist/leaflet.css';
import '../styles/global.css';
import { trips } from '../data/trips';
import { parseGpx } from '../lib/gpx';
import { resolve } from 'node:path';
import { pathToFileURL } from 'node:url';

const enrichedTrips = await Promise.all(trips.map(async (trip) => {
  const track = await parseGpx(pathToFileURL(resolve(`public/routes/${trip.id}.gpx`)));
  const stopIndexes: number[] = [];
  trip.stops.forEach((stop) => {
    const previous = stopIndexes.at(-1) ?? 0;
    let nearest = previous;
    let nearestDistance = Infinity;
    for (let index = previous; index < track.points.length; index++) {
      const point = track.points[index];
      const distance = (point.lon - stop.coordinates[0]) ** 2 + (point.lat - stop.coordinates[1]) ** 2;
      if (distance < nearestDistance) {
        nearest = index;
        nearestDistance = distance;
      }
    }
    stopIndexes.push(nearest);
  });
  const segments = trip.stops.slice(0, -1).map((stop, index) => {
    const points = track.points.slice(stopIndexes[index], stopIndexes[index + 1] + 1);
    const elevations = smooth(points.map((point) => point.ele), 7);
    let ascentM = 0;
    let descentM = 0;
    for (let pointIndex = 1; pointIndex < elevations.length; pointIndex++) {
      const delta = elevations[pointIndex] - elevations[pointIndex - 1];
      if (delta > 1) ascentM += delta;
      if (delta < -1) descentM -= delta;
    }
    const offset = points[0]?.distance ?? 0;
    return {
      index,
      from: stop.name,
      to: trip.stops[index + 1].name,
      note: trip.stops[index + 1].note ?? `Stage ${index + 1} of ${trip.stops.length - 1}.`,
      kind: stop.kind === 'ferry' || trip.stops[index + 1].kind === 'ferry' ? 'ferry' : 'ride',
      coordinates: points
        .filter((_, pointIndex) => pointIndex % 4 === 0 || pointIndex === points.length - 1)
        .map((point) => [point.lon, point.lat, point.ele]),
      stats: {
        distanceKm: Math.max(0, (points.at(-1)?.distance ?? offset) - offset),
        ascentM,
        descentM,
      },
      profile: points.filter((_, pointIndex) => pointIndex % 5 === 0).map(({ distance, ele }) => [distance - offset, ele]),
    };
  });
  return {
    ...trip,
    stats: {
      distanceKm: Math.round(track.distanceKm),
      ascentM: Math.round(track.ascentM / 10) * 10,
      descentM: Math.round(track.descentM / 10) * 10,
      stopCount: trip.stops.filter((stop) => stop.kind !== 'ferry').length,
    },
    track: {
      coordinates: track.coordinates.filter((_, index) => index % 16 === 0 || index === track.coordinates.length - 1),
      bounds: track.bounds,
      profile: track.points.filter((_, index) => index % 8 === 0).map(({ distance, ele }) => [distance, ele]),
    },
    segments,
    gpx: `routes/${trip.id}.gpx`,
  };
}));

function smooth(values: number[], width: number) {
  const radius = Math.floor(width / 2);
  return values.map((_, index) => {
    const slice = values.slice(Math.max(0, index - radius), Math.min(values.length, index + radius + 1));
    return slice.reduce((sum, value) => sum + value, 0) / Math.max(1, slice.length);
  });
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Six bikepacking trips shared by Max and Clément, mapped from diary notes and GPX tracks." />
    <link rel="preconnect" href="https://tile.openstreetmap.org" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" rel="stylesheet" />
    <title>Des potes et des vélos — Max & Clément</title>
  </head>
  <body>
    <main>
      <div id="map" aria-label="Map of six cycling trips"></div>

      <header class="masthead">
        <button class="brand" data-reset aria-label="Show every trip">
          <span class="brand-mark" aria-hidden="true">M<span>×</span>C</span>
          <span><strong>Des potes et des vélos</strong><small>Max & Clément · 2021—2026</small></span>
        </button>
        <div class="map-hint"><span></span> Pick a route or a stop</div>
      </header>

      <nav class="trip-switcher" aria-label="Trips">
        {enrichedTrips.map((trip, index) => (
          <button class="trip-chip" data-trip={trip.id} style={`--trip-color:${trip.color}`} aria-pressed="false">
            <span class="trip-index">0{index + 1}</span>
            <span><strong>{trip.shortName}</strong><small>{trip.year}</small></span>
          </button>
        ))}
      </nav>

      <button class="overview-card" data-reset aria-label="Return to the overview">
        <span>Six summers on two wheels</span>
        <strong>{enrichedTrips.reduce((sum, trip) => sum + trip.stats.distanceKm, 0).toLocaleString('en-GB')} km</strong>
        <small>mapped from GPX tracks</small>
      </button>

      <aside class="drawer" aria-live="polite" aria-label="Trip details">
        <button class="drawer-close" aria-label="Close details">×</button>
        <div class="drawer-scroll">
          <div class="eyebrow" data-drawer-eyebrow></div>
          <h1 data-drawer-title></h1>
          <p class="tagline" data-drawer-tagline></p>
          <div class="stats" data-drawer-stats></div>
          <div class="elevation-wrap">
            <div class="section-label">Elevation profile</div>
            <svg class="elevation" viewBox="0 0 600 120" preserveAspectRatio="none" role="img" aria-label="Elevation profile"></svg>
          </div>
          <p class="story" data-drawer-story></p>
          <div class="data-note" data-drawer-source></div>
          <div class="section-label">The stops</div>
          <ol class="stop-list" data-drawer-stops></ol>
          <a class="download" data-drawer-download download>
            <span>↓</span><span><strong>Download GPX</strong><small>Route, waypoints & elevation</small></span>
          </a>
        </div>
      </aside>

      <div class="mobile-scrim"></div>
      <footer>Map data © OpenStreetMap contributors · Routes reconstructed with Valhalla</footer>
    </main>

    <script type="application/json" id="trip-data" set:html={JSON.stringify(enrichedTrips)}></script>
    <script>
      // @ts-nocheck
      import L from 'leaflet';

      const trips = JSON.parse(document.querySelector('#trip-data').textContent);
      const map = L.map('map', { zoomControl: false, attributionControl: false }).setView([47, 2.5], 5);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap contributors',
      }).addTo(map);
      L.control.zoom({ position: 'bottomleft' }).addTo(map);
      L.control.attribution({ position: 'bottomright', prefix: false }).addTo(map);

      const drawer = document.querySelector('.drawer');
      const scrim = document.querySelector('.mobile-scrim');
      let activeTrip = null;

      trips.forEach((trip) => {
          trip.segments.forEach((segment) => {
            const points = segment.coordinates.map(([lon, lat]) => [lat, lon]);
            L.polyline(points, { color: '#fffdf7', weight: 9, opacity: 0.88, interactive: false }).addTo(map);
            const line = L.polyline(points, { color: trip.color, weight: 4, opacity: 0.92 }).addTo(map);
            const hitLine = L.polyline(points, { color: trip.color, weight: 18, opacity: 0.001 }).addTo(map);
            hitLine.on('mouseover', () => line.setStyle({ weight: 7, opacity: 1 }));
            hitLine.on('mouseout', () => line.setStyle({ weight: 4, opacity: 0.92 }));
            hitLine.on('click', () => selectTrip(trip.id, null, segment.index));
          });

          trip.stops.forEach((stop, stopIndex) => {
            const html = `<button class="map-node ${stop.kind === 'ferry' ? 'is-ferry' : ''}" style="--trip-color:${trip.color}" title="${stop.name}"><span>${String(stopIndex + 1).padStart(2, '0')}</span></button>`;
            const icon = L.divIcon({ className: 'map-node-wrapper', html, iconSize: [25, 25], iconAnchor: [12, 12] });
            L.marker([stop.coordinates[1], stop.coordinates[0]], { icon, title: stop.name })
              .on('click', () => selectTrip(trip.id, stopIndex, null))
              .addTo(map);
          });
      });
      fitAll();

      function selectTrip(id, stopIndex = null, segmentIndex = null) {
        const trip = trips.find((candidate) => candidate.id === id);
        const segment = Number.isInteger(segmentIndex) ? trip.segments[segmentIndex] : null;
        activeTrip = id;
        document.body.classList.add('drawer-open');
        drawer.style.setProperty('--trip-color', trip.color);
        document.querySelector('[data-drawer-eyebrow]').textContent = segment
          ? `${trip.shortName} · Stage ${String(segment.index + 1).padStart(2, '0')} of ${String(trip.segments.length).padStart(2, '0')}`
          : `${trip.dates} · Trip ${String(trips.indexOf(trip) + 1).padStart(2, '0')}`;
        document.querySelector('[data-drawer-title]').textContent = segment ? `${segment.from} → ${segment.to}` : trip.name;
        document.querySelector('[data-drawer-tagline]').textContent = segment ? segment.note : trip.tagline;
        document.querySelector('[data-drawer-story]').textContent = segment
          ? `${segment.kind === 'ferry' ? 'Ferry connection' : 'Cycling stage'} between stop ${segment.index + 1} and stop ${segment.index + 2} on ${trip.name}. Its figures and profile are calculated from this portion of the GPX track.`
          : trip.story;
        document.querySelector('[data-drawer-source]').innerHTML = `<span>${trip.confidence}</span>${trip.source}`;
        document.querySelector('[data-drawer-download]').href = trip.gpx;
        document.querySelector('[data-drawer-download]').download = `${trip.id}.gpx`;
        const selectedStats = segment ? {
          distanceKm: Math.round(segment.stats.distanceKm),
          ascentM: Math.round(segment.stats.ascentM / 10) * 10,
          thirdLabel: 'Descent',
          thirdValue: `${(Math.round(segment.stats.descentM / 10) * 10).toLocaleString('en-GB')} m`,
        } : {
          distanceKm: trip.stats.distanceKm,
          ascentM: trip.stats.ascentM,
          thirdLabel: 'Stops',
          thirdValue: trip.stats.stopCount,
        };
        document.querySelector('[data-drawer-stats]').innerHTML = [
          ['Distance', `${selectedStats.distanceKm.toLocaleString('en-GB')} km`],
          ['Ascent', `${selectedStats.ascentM.toLocaleString('en-GB')} m`],
          [selectedStats.thirdLabel, selectedStats.thirdValue],
        ].map(([label, value]) => `<div><strong>${value}</strong><span>${label}</span></div>`).join('');
        const list = document.querySelector('[data-drawer-stops]');
        list.innerHTML = trip.stops.map((stop, index) => `<li class="${index === stopIndex || (segment && (index === segment.index || index === segment.index + 1)) ? 'is-active' : ''}" data-stop="${index}"><button><span>${String(index + 1).padStart(2, '0')}</span><div><strong>${stop.name}</strong>${stop.note ? `<small>${stop.note}</small>` : ''}</div></button></li>`).join('');
        list.querySelectorAll('button').forEach((button, index) => button.addEventListener('click', () => {
          const stop = trip.stops[index];
          map.flyTo([stop.coordinates[1], stop.coordinates[0]], 10, { duration: 1.2 });
          list.querySelector('.is-active')?.classList.remove('is-active');
          button.parentElement.classList.add('is-active');
        }));
        drawElevation(trip, segment);
        document.querySelectorAll('.trip-chip').forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.trip === id)));
        const activeCoordinates = segment?.coordinates ?? trip.track.coordinates;
        const bounds = L.latLngBounds(activeCoordinates.map(([lon, lat]) => [lat, lon]));
        map.fitBounds(bounds, {
          paddingTopLeft: [90, 100],
          paddingBottomRight: [window.innerWidth > 800 ? 520 : 90, 90],
          animate: true,
          duration: 1.2,
        });
        if (Number.isInteger(stopIndex)) setTimeout(() => list.querySelector(`[data-stop="${stopIndex}"]`)?.scrollIntoView({ block: 'center' }), 250);
      }

      function drawElevation(trip, segment = null) {
        const svg = document.querySelector('.elevation');
        const profile = segment?.profile ?? trip.track.profile;
        const maxDistance = profile.at(-1)[0];
        const elevations = profile.map((point) => point[1]);
        const min = Math.min(...elevations);
        const max = Math.max(...elevations);
        const points = profile.map(([distance, elevation]) => `${(distance / maxDistance) * 600},${108 - ((elevation - min) / Math.max(1, max - min)) * 94}`).join(' ');
        svg.innerHTML = `<defs><linearGradient id="profile-${trip.id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${trip.color}" stop-opacity=".42"/><stop offset="1" stop-color="${trip.color}" stop-opacity=".03"/></linearGradient></defs><polygon points="0,120 ${points} 600,120" fill="url(#profile-${trip.id})"/><polyline points="${points}" fill="none" stroke="${trip.color}" stroke-width="3" vector-effect="non-scaling-stroke"/><text x="4" y="116">${Math.round(min)} m</text><text x="596" y="116" text-anchor="end">${Math.round(max)} m</text>`;
      }

      function closeDrawer() {
        activeTrip = null;
        document.body.classList.remove('drawer-open');
        document.querySelectorAll('.trip-chip').forEach((chip) => chip.setAttribute('aria-pressed', 'false'));
      }

      function fitAll() {
        closeDrawer();
        const points = trips.flatMap((trip) => trip.track.coordinates.map(([lon, lat]) => [lat, lon]));
        map.fitBounds(L.latLngBounds(points), { padding: [120, 120], animate: true, duration: 1 });
      }

      document.querySelectorAll('.trip-chip').forEach((chip) => chip.addEventListener('click', () => selectTrip(chip.dataset.trip)));
      document.querySelectorAll('[data-reset]').forEach((button) => button.addEventListener('click', fitAll));
      document.querySelector('.drawer-close').addEventListener('click', closeDrawer);
      scrim.addEventListener('click', closeDrawer);
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeDrawer(); });
    </script>
  </body>
</html>
