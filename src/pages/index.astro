---
import 'leaflet/dist/leaflet.css';
import 'maplibre-gl/dist/maplibre-gl.css';
import '../styles/global.css';
import { trips } from '../data/trips';
import { parseGpx } from '../lib/gpx';
import { resolve } from 'node:path';
import { pathToFileURL } from 'node:url';

const enrichedTrips = await Promise.all(trips.map(async (trip) => {
  const track = await parseGpx(pathToFileURL(resolve(`public/routes/${trip.id}.gpx`)));
  const stopIndexes: number[] = [];

  trip.stops.forEach((stop) => {
    const previous = stopIndexes.at(-1) ?? 0;
    let nearest = previous;
    let nearestDistance = Infinity;

    for (let index = previous; index < track.points.length; index++) {
      const point = track.points[index];
      const distance = (point.lon - stop.coordinates[0]) ** 2 + (point.lat - stop.coordinates[1]) ** 2;
      if (distance < nearestDistance) {
        nearest = index;
        nearestDistance = distance;
      }
    }
    stopIndexes.push(nearest);
  });

  const segments = trip.stops.slice(0, -1).map((stop, index) => {
    const points = track.points.slice(stopIndexes[index], stopIndexes[index + 1] + 1);
    const elevations = smooth(points.map((point) => point.ele), 7);
    let ascentM = 0;
    let descentM = 0;

    for (let pointIndex = 1; pointIndex < elevations.length; pointIndex++) {
      const delta = elevations[pointIndex] - elevations[pointIndex - 1];
      if (delta > 1) ascentM += delta;
      if (delta < -1) descentM -= delta;
    }

    const offset = points[0]?.distance ?? 0;
    return {
      index,
      from: stop.name,
      to: trip.stops[index + 1].name,
      kind: stop.kind === 'ferry' && trip.stops[index + 1].kind === 'ferry' ? 'ferry' : 'ride',
      coordinates: points
        .filter((_, pointIndex) => pointIndex % 4 === 0 || pointIndex === points.length - 1)
        .map((point) => [point.lon, point.lat, point.ele]),
      stats: {
        distanceKm: Math.max(0, (points.at(-1)?.distance ?? offset) - offset),
        ascentM,
        descentM,
      },
      profile: points
        .filter((_, pointIndex) => pointIndex % 5 === 0 || pointIndex === points.length - 1)
        .map(({ distance, ele }) => [distance - offset, ele]),
    };
  });

  return {
    ...trip,
    stats: {
      distanceKm: Math.round(track.distanceKm),
      ascentM: Math.round(track.ascentM / 10) * 10,
      descentM: Math.round(track.descentM / 10) * 10,
      stopCount: trip.stops.length,
    },
    track: {
      coordinates: track.coordinates.filter((_, index) => index % 16 === 0 || index === track.coordinates.length - 1),
      profile: track.points
        .filter((_, index) => index % 8 === 0 || index === track.points.length - 1)
        .map(({ distance, ele }) => [distance, ele]),
    },
    segments,
    gpx: `routes/${trip.id}.gpx`,
  };
}));

function smooth(values: number[], width: number) {
  const radius = Math.floor(width / 2);
  return values.map((_, index) => {
    const slice = values.slice(Math.max(0, index - radius), Math.min(values.length, index + radius + 1));
    return slice.reduce((sum, value) => sum + value, 0) / Math.max(1, slice.length);
  });
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Six cycling trips, mapped with their routes and stops." />
    <link rel="preconnect" href="https://tiles.openfreemap.org" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" rel="stylesheet" />
    <title>Des potes et des vélos</title>
  </head>
  <body>
    <main>
      <div id="map" aria-label="Map of six cycling trips"></div>

      <header class="masthead">
        <button class="brand" data-reset aria-label="Show every trip">
          <strong>Des potes et des vélos</strong>
        </button>

        <div class="basemap-switcher" role="group" aria-label="Map style">
          <span>Map</span>
          <button data-basemap="liberty" aria-pressed="true">Liberty</button>
          <button data-basemap="positron" aria-pressed="false">Positron</button>
        </div>
      </header>

      <nav class="trip-switcher" aria-label="Trips">
        {enrichedTrips.map((trip, index) => (
          <button class="trip-chip" data-trip={trip.id} style={`--trip-color:${trip.color}`} aria-pressed="false">
            <span class="trip-index">{String(index + 1).padStart(2, '0')}</span>
            <span><strong>{trip.shortName}</strong><small>{trip.dates}</small></span>
          </button>
        ))}
      </nav>

      <aside class="drawer" aria-live="polite" aria-label="Route details">
        <button class="drawer-close" aria-label="Close details">×</button>
        <div class="drawer-scroll">
          <div class="eyebrow" data-drawer-eyebrow></div>
          <h1 data-drawer-title></h1>
          <div class="stats" data-drawer-stats></div>
          <div class="elevation-wrap">
            <div class="section-label">Elevation profile</div>
            <svg class="elevation" viewBox="0 0 600 120" preserveAspectRatio="none" role="img" aria-label="Elevation profile"></svg>
          </div>
          <div class="section-label">Stops</div>
          <ol class="stop-list" data-drawer-stops></ol>
          <a class="download" data-drawer-download download>
            <span aria-hidden="true">↓</span>
            <span><strong>Download GPX</strong><small>Route, waypoints and elevation</small></span>
          </a>
        </div>
      </aside>

      <div class="mobile-scrim"></div>
    </main>

    <script type="application/json" id="trip-data" set:html={JSON.stringify(enrichedTrips)}></script>
    <script>
      // @ts-nocheck
      import L from 'leaflet';
      import { maplibreGL } from '@maplibre/maplibre-gl-leaflet';
      import { setWorkerUrl } from 'maplibre-gl';
      import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';

      setWorkerUrl(workerUrl);

      const trips = JSON.parse(document.querySelector('#trip-data').textContent);
      const map = L.map('map', { zoomControl: false, attributionControl: false }).setView([47, 2.5], 5);
      const basemapStyles = {
        liberty: 'https://tiles.openfreemap.org/styles/liberty',
        positron: 'https://tiles.openfreemap.org/styles/positron',
      };
      const storedBasemap = localStorage.getItem('basemap');
      const initialBasemap = storedBasemap in basemapStyles ? storedBasemap : 'liberty';
      const basemap = maplibreGL({
        style: basemapStyles[initialBasemap],
        attribution: '<a href="https://openfreemap.org">OpenFreeMap</a> © <a href="https://openmaptiles.org">OpenMapTiles</a> © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);

      L.control.zoom({ position: 'bottomleft' }).addTo(map);
      L.control.attribution({ position: 'bottomright', prefix: false }).addTo(map);

      const drawer = document.querySelector('.drawer');
      const drawerScroll = document.querySelector('.drawer-scroll');
      const scrim = document.querySelector('.mobile-scrim');
      const tripLayers = new Map();
      let selection = null;

      document.querySelectorAll('[data-basemap]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.basemap === initialBasemap));
        button.addEventListener('click', () => {
          const style = button.dataset.basemap;
          if (!basemapStyles[style]) return;
          basemap.getMaplibreMap().setStyle(basemapStyles[style]);
          localStorage.setItem('basemap', style);
          document.querySelectorAll('[data-basemap]').forEach((candidate) => {
            candidate.setAttribute('aria-pressed', String(candidate === button));
          });
        });
      });

      trips.forEach((trip) => {
        const segmentLayers = [];
        const markers = [];

        trip.segments.forEach((segment) => {
          const points = segment.coordinates.map(([lon, lat]) => [lat, lon]);
          const outline = L.polyline(points, {
            color: '#fffdf7',
            weight: 9,
            opacity: 0.82,
            interactive: false,
          }).addTo(map);
          const line = L.polyline(points, {
            color: trip.color,
            weight: 4,
            opacity: 0.92,
            interactive: false,
          }).addTo(map);
          const hitLine = L.polyline(points, {
            color: trip.color,
            weight: 20,
            opacity: 0.001,
          }).addTo(map);

          hitLine.on('mouseover', () => {
            if (!isSelectedSegment(trip.id, segment.index)) line.setStyle({ weight: 6, opacity: 1 });
          });
          hitLine.on('mouseout', updateMapSelection);
          hitLine.on('click', () => selectTrip(trip.id, { segmentIndex: segment.index }));
          segmentLayers.push({ outline, line, hitLine });
        });

        trip.stops.forEach((stop, stopIndex) => {
          const html = `<span class="map-node ${stop.kind === 'ferry' ? 'is-ferry' : ''}" style="--trip-color:${trip.color}"><span>${String(stopIndex + 1).padStart(2, '0')}</span></span>`;
          const icon = L.divIcon({
            className: 'map-node-wrapper',
            html,
            iconSize: [27, 27],
            iconAnchor: [13, 13],
          });
          const marker = L.marker([stop.coordinates[1], stop.coordinates[0]], {
            icon,
            title: stop.name,
            bubblingMouseEvents: false,
          })
            .bindTooltip(stop.name, { direction: 'top', offset: [0, -10] })
            .on('click', () => selectTrip(trip.id, { stopIndex }))
            .addTo(map);
          markers.push(marker);
        });

        tripLayers.set(trip.id, { segments: segmentLayers, markers });
      });

      fitAll(false);

      function selectTrip(id, options = {}) {
        const trip = trips.find((candidate) => candidate.id === id);
        const stopIndex = Number.isInteger(options.stopIndex) ? options.stopIndex : null;
        const segmentIndex = Number.isInteger(options.segmentIndex) ? options.segmentIndex : null;
        const segment = segmentIndex !== null ? trip.segments[segmentIndex] : null;
        const stop = stopIndex !== null ? trip.stops[stopIndex] : null;
        const wasOpen = document.body.classList.contains('drawer-open');

        selection = { tripId: id, stopIndex, segmentIndex };
        document.body.classList.add('drawer-open');
        drawer.style.setProperty('--trip-color', trip.color);

        document.querySelector('[data-drawer-eyebrow]').textContent = segment
          ? `${trip.name} · Stage ${String(segment.index + 1).padStart(2, '0')} of ${String(trip.segments.length).padStart(2, '0')}`
          : stop
            ? `${trip.name} · Stop ${String(stopIndex + 1).padStart(2, '0')} of ${String(trip.stops.length).padStart(2, '0')}`
            : trip.dates;
        document.querySelector('[data-drawer-title]').textContent = segment
          ? `${segment.from} → ${segment.to}`
          : stop?.name ?? trip.name;

        const selectedStats = segment
          ? [
              ['Distance', `${Math.round(segment.stats.distanceKm).toLocaleString('en-GB')} km`],
              ['Ascent', `${(Math.round(segment.stats.ascentM / 10) * 10).toLocaleString('en-GB')} m`],
              ['Descent', `${(Math.round(segment.stats.descentM / 10) * 10).toLocaleString('en-GB')} m`],
            ]
          : stop
            ? [
                ['Trip distance', `${trip.stats.distanceKm.toLocaleString('en-GB')} km`],
                ['Trip ascent', `${trip.stats.ascentM.toLocaleString('en-GB')} m`],
                ['Position', `${stopIndex + 1} / ${trip.stops.length}`],
              ]
            : [
                ['Distance', `${trip.stats.distanceKm.toLocaleString('en-GB')} km`],
                ['Ascent', `${trip.stats.ascentM.toLocaleString('en-GB')} m`],
                ['Stops', trip.stats.stopCount],
              ];

        document.querySelector('[data-drawer-stats]').innerHTML = selectedStats
          .map(([label, value]) => `<div><strong>${value}</strong><span>${label}</span></div>`)
          .join('');

        const list = document.querySelector('[data-drawer-stops]');
        list.innerHTML = trip.stops.map((item, index) => {
          const isActive = index === stopIndex || (segment && (index === segment.index || index === segment.index + 1));
          return `<li class="${isActive ? 'is-active' : ''}" data-stop="${index}"><button><span>${String(index + 1).padStart(2, '0')}</span><strong>${item.name}</strong></button></li>`;
        }).join('');
        list.querySelectorAll('button').forEach((button, index) => {
          button.addEventListener('click', () => selectTrip(id, { stopIndex: index }));
        });

        const download = document.querySelector('[data-drawer-download]');
        download.href = trip.gpx;
        download.download = `${trip.id}.gpx`;
        drawElevation(trip, segment);
        updateMapSelection();

        document.querySelectorAll('.trip-chip').forEach((chip) => {
          chip.setAttribute('aria-pressed', String(chip.dataset.trip === id));
        });

        if (stop) {
          focusStop(stop);
          requestAnimationFrame(() => requestAnimationFrame(() => {
            list.querySelector(`[data-stop="${stopIndex}"]`)?.scrollIntoView({
              behavior: wasOpen ? 'smooth' : 'auto',
              block: 'center',
            });
          }));
        } else {
          drawerScroll.scrollTo({ top: 0, behavior: wasOpen ? 'smooth' : 'auto' });
          const coordinates = segment?.coordinates ?? trip.track.coordinates;
          fitCoordinates(coordinates);
        }
      }

      function focusStop(stop) {
        const destination = [stop.coordinates[1], stop.coordinates[0]];
        map.flyTo(destination, Math.max(map.getZoom(), 10), { duration: 0.85 });
        if (window.innerWidth > 800) {
          map.once('moveend', () => map.panBy([210, 0], { animate: true, duration: 0.25 }));
        }
      }

      function fitCoordinates(coordinates) {
        const bounds = L.latLngBounds(coordinates.map(([lon, lat]) => [lat, lon]));
        map.fitBounds(bounds, {
          paddingTopLeft: [90, 90],
          paddingBottomRight: [window.innerWidth > 800 ? 520 : 90, 100],
          animate: true,
          duration: 0.85,
        });
      }

      function isSelectedSegment(tripId, segmentIndex) {
        return selection?.tripId === tripId && selection?.segmentIndex === segmentIndex;
      }

      function updateMapSelection() {
        tripLayers.forEach((layers, tripId) => {
          const tripIsActive = !selection || selection.tripId === tripId;
          layers.segments.forEach(({ outline, line }, segmentIndex) => {
            const segmentIsActive = isSelectedSegment(tripId, segmentIndex);
            outline.setStyle({ opacity: tripIsActive ? 0.82 : 0.18, weight: segmentIsActive ? 12 : 9 });
            line.setStyle({
              opacity: tripIsActive ? (selection?.segmentIndex === null || selection?.segmentIndex === undefined || segmentIsActive ? 0.96 : 0.55) : 0.16,
              weight: segmentIsActive ? 7 : 4,
            });
            if (segmentIsActive) {
              outline.bringToFront();
              line.bringToFront();
            }
          });

          layers.markers.forEach((marker, stopIndex) => {
            const node = marker.getElement()?.querySelector('.map-node');
            node?.classList.toggle('is-muted', !tripIsActive);
            node?.classList.toggle('is-active', selection?.tripId === tripId && selection?.stopIndex === stopIndex);
          });
        });
      }

      function drawElevation(trip, segment = null) {
        const svg = document.querySelector('.elevation');
        const profile = segment?.profile ?? trip.track.profile;
        if (!profile.length) {
          svg.replaceChildren();
          return;
        }
        const maxDistance = Math.max(1, profile.at(-1)[0]);
        const elevations = profile.map((point) => point[1]);
        const min = Math.min(...elevations);
        const max = Math.max(...elevations);
        const points = profile.map(([distance, elevation]) =>
          `${(distance / maxDistance) * 600},${108 - ((elevation - min) / Math.max(1, max - min)) * 94}`
        ).join(' ');
        svg.innerHTML = `<defs><linearGradient id="profile-${trip.id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${trip.color}" stop-opacity=".42"/><stop offset="1" stop-color="${trip.color}" stop-opacity=".03"/></linearGradient></defs><polygon points="0,120 ${points} 600,120" fill="url(#profile-${trip.id})"/><polyline points="${points}" fill="none" stroke="${trip.color}" stroke-width="3" vector-effect="non-scaling-stroke"/><text x="4" y="116">${Math.round(min)} m</text><text x="596" y="116" text-anchor="end">${Math.round(max)} m</text>`;
      }

      function closeDrawer() {
        selection = null;
        document.body.classList.remove('drawer-open');
        document.querySelectorAll('.trip-chip').forEach((chip) => chip.setAttribute('aria-pressed', 'false'));
        updateMapSelection();
      }

      function fitAll(animate = true) {
        closeDrawer();
        const points = trips.flatMap((trip) => trip.track.coordinates.map(([lon, lat]) => [lat, lon]));
        map.fitBounds(L.latLngBounds(points), { padding: [110, 110], animate, duration: 0.85 });
      }

      document.querySelectorAll('.trip-chip').forEach((chip) => {
        chip.addEventListener('click', () => selectTrip(chip.dataset.trip));
      });
      document.querySelectorAll('[data-reset]').forEach((button) => button.addEventListener('click', () => fitAll()));
      document.querySelector('.drawer-close').addEventListener('click', closeDrawer);
      scrim.addEventListener('click', closeDrawer);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeDrawer();
      });
    </script>
  </body>
</html>
